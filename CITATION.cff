cff-version: 1.2.0
message: "If you use ANOVA Methods (psystats, psymetrics, psyreport), please cite it as below."
title: "ANOVA Methods: psystats, psymetrics, and psyreport"
abstract: >-
  A family of three free and open Python packages for quantitative psychology:
  psystats (descriptives, group comparison tables, inferential tests with effect
  sizes, regression, risk measures), psymetrics (reliability, factorability,
  exploratory and confirmatory factor analysis, SEM), and psyreport (APA 7 text,
  LaTeX and Word table export).
type: software
authors:
  - family-names: "Anunciação"
    given-names: "Luis"
    orcid: "https://orcid.org/0000-0001-5303-5782"
    affiliation: "Pontifical Catholic University of Rio de Janeiro (PUC-Rio); University of Oregon"
version: 0.1.2
date-released: "2026-07-25"
license: MIT
repository-code: "https://github.com/anovabr/anova-methods"
url: "https://github.com/anovabr/anova-methods"
keywords:
  - psychology
  - statistics
  - biostatistics
  - psychometrics
  - factor analysis
  - APA reporting

identifiers:
  # Cite the concept DOI: it always resolves to the newest archived release,
  # so a citation does not go stale when a new version is published.
  - type: doi
    value: "10.5281/zenodo.21566785"
    description: "Concept DOI resolving to the latest release"
  - type: doi
    value: "10.5281/zenodo.21566786"
    description: "Version DOI for the archived release v0.1.2"
